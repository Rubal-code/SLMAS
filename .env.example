# Core app config
APP_ENV=production
DEBUG=false
PORT=8000
WORKERS=2
SECRET_KEY=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
ENABLE_ADMIN_APPROVAL=true

# Groq API settings
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# Database and queue config
DATABASE_URL=sqlite:///./data/agent.sqlite
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=slmas_memory
REDIS_URL=redis://localhost:6379/0

# Production example: PostgreSQL
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/slmas

# Optional observability
# SENTRY_DSN=
# LOG_LEVEL=INFO
